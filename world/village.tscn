script = ExtResource("5_elara")
dialogue_tree = [{
"id": "elara_greeting",
"is_decisive": false,
"options": [{
"label": "[우물에 대해 묻는다]",
"next_id": "elara_well"
}, {
"label": "[마을에 대해 묻는다]",
"next_id": "elara_village"
}, {
"label": "[그냥 안부를 묻는다]",
"next_id": "elara_smalltalk"
}, {
"label": "[의뢰? 뭐 일거리 있나요?]",
"next_id": "elara_bounty_intro"
}, {
"label": "[다른 사람들에 대해 묻는다]",
"next_id": "elara_gossip",
"show_if_flag": "met_rohan"
}, {
"label": "[다녀왔다고 말한다]",
"next_id": "elara_ending_check",
"show_if_flag": "guardian_event_done"
}, {
"label": "[궁금한 게 있어요, 장로님]",
"next_id": "elara_secret_intro",
"required_affinity": {
"min": 60,
"npc_id": "elara"
},
"show_if_not_seen": "elara_secret_end"
}, {
"label": "[그 기록에 대해서 더 생각해봤나]",
"next_id": "elara_secret_followup",
"show_if_seen": "elara_secret_end"
}, {
"give_gift": {
"amount": 9,
"next_id_fail": "elara_gift_none",
"next_id_success": "elara_gift_thanks",
"npc_id": "elara"
},
"label": "[선물을 준다]"
}],
"speaker": "엘라라",
"text": "오, 자네로군. 우물 일 때문에 왔겠지.",
"text_by_affinity_tier": {
"cold": "...무슨 일이지.",
"neutral": "오, 자네로군. 우물 일 때문에 왔겠지.",
"npc_id": "elara",
"trusted": "자네가 와줘서 다행이야. 요즘 자네 얼굴을 보면 든든해.",
"warm": "왔는가. 자네를 보면 마음이 놓이는군."
}
}, {
"id": "elara_bounty_intro",
"is_decisive": false,
"options": [{
"label": "[의뢰판을 살펴본다]",
"open_bounty_board": true
}, {
"label": "[다음에 볼게요]",
"next_id": ""
}],
"speaker": "엘라라",
"text": "마침 잘 왔군. 마을 사람들이 붙여둔 의뢰가 몇 있네. 손이 비었으면 한번 보게나."
}, {
"id": "elara_gift_thanks",
"is_decisive": false,
"options": [],
"speaker": "엘라라",
"text": "이런 걸... 나한테? 허허, 고맙구나. 늙은이 마음이 다 따뜻해지는군."
}, {
"id": "elara_gift_none",
"is_decisive": false,
"narration": "(막상 건넬 것이 없다)",
"options": [],
"speaker": "엘라라",
"text": "줄 게 없네요."
}, {
"affinity_change_on_show": {
"amount": 2,
"npc_id": "elara",
"once": true
},
"id": "elara_well",
"is_decisive": false,
"options": [{
"label": "[심각한 건가요?]",
"next_id": "elara_well_serious"
}, {
"label": "[제가 도와드릴게요]",
"next_id": "elara_well_help"
}],
"speaker": "엘라라",
"text": "사흘 전부터 한 방울도 안 나와. 이런 적은... 내 평생 처음이야."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "elara",
"once": true
},
"id": "elara_well_serious",
"is_decisive": false,
"options": [{
"label": "[왜 하필 지금인가요?]",
"next_id": "elara_well_why"
}, {
"label": "[알겠어요, 해결해볼게요]",
"next_id": ""
}],
"speaker": "엘라라",
"text": "심각하냐고? 물이 없으면 마을이 죽어. 그 정도로 심각해."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "elara",
"once": true
},
"id": "elara_well_why",
"is_decisive": false,
"options": [],
"speaker": "엘라라",
"text": "낸들 알겠나. 다만... 이런 일은 늘 조용히 찾아오지, 경고도 없이."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "elara",
"once": true
},
"id": "elara_well_help",
"is_decisive": false,
"next_id": "elara_well_lore",
"speaker": "엘라라",
"text": "고맙구나. 숲의 로한을 먼저 만나보게. 동굴 근처에서 뭔가 봤다더군."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "elara",
"once": true
},
"id": "elara_well_lore",
"is_decisive": false,
"options": [{
"label": "[무슨 말씀이세요?]",
"next_id": "elara_well_lore2"
}, {
"label": "[알겠어요, 가볼게요]",
"next_id": ""
}],
"speaker": "엘라라",
"text": "...자네도 들어봤을지 모르겠군. 이 물줄기가, 실은 이 마을만의 것이 아니라는 걸."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "elara",
"once": true
},
"id": "elara_well_lore2",
"is_decisive": false,
"options": [{
"label": "[걱정되네요]",
"next_id": "elara_well_lore3"
}, {
"label": "[제가 알아볼게요]",
"next_id": ""
}],
"speaker": "엘라라",
"text": "오래전부터... 세상 곳곳의 물줄기가 하나둘 말라간다고 하더군. 다행히 우리 마을은 여태 무사했는데... 결국 이렇게 됐어."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "elara",
"once": true
},
"id": "elara_well_lore3",
"is_decisive": false,
"options": [],
"speaker": "엘라라",
"text": "너무 겁먹진 말게. 자네라면... 뭔가 다를 것 같은 예감이 드는군."
}, {
"id": "elara_ending_check",
"is_decisive": false,
"options": [{
"label": "[자세히 이야기한다]",
"next_id": "elara_ending_reflect"
}, {
"label": "[그냥 결과만 말한다]",
"next_id": "elara_ending_trigger"
}],
"speaker": "엘라라",
"text": "...끝났나 보군. 그래, 결과는 어떻게 됐나?"
}, {
"id": "elara_ending_reflect",
"is_decisive": false,
"next_id": "elara_ending_trigger",
"speaker": "엘라라",
"text": "...그런가. 자네가 겪은 일이, 그 물줄기의 비밀에 조금은 가까워진 걸지도 모르겠군."
}, {
"id": "elara_ending_trigger",
"is_decisive": false,
"options": [],
"set_flag_on_show": "part1_reported",
"speaker": "엘라라",
"text": "...그래. 이제 좀 지켜봐야겠군."
}, {
"affinity_change_on_show": {
"amount": 2,
"npc_id": "elara",
"once": true
},
"id": "elara_village",
"is_decisive": false,
"options": [{
"label": "[오래됐네요]",
"next_id": "elara_village_old"
}, {
"label": "[평화로워 보여요]",
"next_id": "elara_village_peace"
}],
"speaker": "엘라라",
"text": "작은 곳이지. 하지만 백 년 넘게 이 자리를 지켜왔어."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "elara",
"once": true
},
"id": "elara_village_old",
"is_decisive": false,
"options": [],
"speaker": "엘라라",
"text": "그만큼 많은 걸 봐왔지. 좋은 일도, 나쁜 일도."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "elara",
"once": true
},
"id": "elara_village_peace",
"is_decisive": false,
"options": [],
"speaker": "엘라라",
"text": "평화... 그래, 지금까진 그랬지."
}, {
"affinity_change_on_show": {
"amount": 2,
"npc_id": "elara",
"once": true
},
"id": "elara_smalltalk",
"is_decisive": false,
"options": [{
"label": "[괜찮아요, 걱정 마세요]",
"next_id": "elara_smalltalk_fine"
}, {
"label": "[사실 좀 지쳤어요]",
"next_id": "elara_smalltalk_tired"
}],
"speaker": "엘라라",
"text": "안부라... 다정하기도 하지. 몸은 성한가?"
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "elara",
"once": true
},
"id": "elara_smalltalk_fine",
"is_decisive": false,
"options": [],
"speaker": "엘라라",
"text": "다행이군. 젊은이가 튼튼해야 마을도 든든하지."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "elara",
"once": true
},
"id": "elara_smalltalk_tired",
"is_decisive": false,
"options": [],
"speaker": "엘라라",
"text": "쉬엄쉬엄하게. 우물이 급하다고 자네까지 쓰러지면 안 되지."
}, {
"id": "elara_gossip",
"is_decisive": false,
"options": [{
"label": "[로한은 어떤 사람인가요?]",
"next_id": "elara_about_rohan",
"show_if_flag": "met_rohan"
}, {
"label": "[유서프는 믿을 만한가요?]",
"next_id": "elara_about_yusuf",
"show_if_flag": "met_yusuf"
}, {
"label": "[미아는 왜 저렇게 겁이 많나요?]",
"next_id": "elara_about_mia",
"show_if_flag": "met_mia"
}],
"speaker": "엘라라",
"text": "[다른 사람들에 대해 물어본다]"
}, {
"id": "elara_about_rohan",
"is_decisive": false,
"options": [],
"speaker": "엘라라",
"text": "무뚝뚝하지만 마을을 아끼는 사람이야. 숲을 그만큼 잘 아는 이도 없지."
}, {
"id": "elara_about_yusuf",
"is_decisive": false,
"options": [],
"speaker": "엘라라",
"text": "믿을 만하냐고... 글쎄. 유서프는 아는 게 너무 많아서 탈이지."
}, {
"id": "elara_about_mia",
"is_decisive": false,
"options": [],
"speaker": "엘라라",
"text": "그 아이는... 얼마 전에 무서운 걸 봤다더군. 다그치지 말게."
}, {
"id": "elara_secret_intro",
"is_decisive": false,
"options": [{
"label": "[무슨 이야기예요?]",
"next_id": "elara_secret_1"
}, {
"label": "[아니에요, 다음에 물어볼게요]",
"next_id": ""
}],
"speaker": "엘라라",
"text": "궁금한 거라... 흠, 자네라면 얘기해도 괜찮을 것 같군."
}, {
"id": "elara_secret_1",
"is_decisive": false,
"next_id": "elara_secret_2",
"speaker": "엘라라",
"text": "실은... 전대 장로님께 물려받은 게 하나 있어. 아주 오래된 기록이지."
}, {
"id": "elara_secret_2",
"is_decisive": false,
"options": [{
"label": "[그때는 어떻게 됐나요?]",
"next_id": "elara_secret_3"
}, {
"label": "[왜 지금까지 숨기셨어요?]",
"next_id": "elara_secret_alt"
}],
"speaker": "엘라라",
"text": "이런 일이... 처음이 아니라는 기록이야. 아주 먼 옛날, 물줄기가 말랐던 적이 또 있었다더군."
}, {
"affinity_change_on_show": {
"amount": 3,
"npc_id": "elara"
},
"id": "elara_secret_3",
"is_decisive": false,
"next_id": "elara_secret_end",
"speaker": "엘라라",
"text": "기록엔... 그냥 '지나갔다'고만 적혀 있어. 어떻게 해결했는지는 안 적혀 있더군. 아니면... 적을 수 없었던 걸지도."
}, {
"affinity_change_on_show": {
"amount": 3,
"npc_id": "elara"
},
"id": "elara_secret_alt",
"is_decisive": false,
"next_id": "elara_secret_end",
"speaker": "엘라라",
"text": "자네도 알잖나, 사람들은 겁부터 먹어. 확실하지도 않은 걸로 마을을 불안하게 만들고 싶지 않았어."
}, {
"id": "elara_secret_end",
"is_decisive": false,
"options": [],
"speaker": "엘라라",
"text": "...아무튼, 이런 얘긴 자네니까 하는 걸세. 다른 이들껜 아직은 비밀로 해주게."
}, {
"id": "elara_secret_followup",
"is_decisive": false,
"options": [{
"label": "[아니요, 아직요]",
"next_id": ""
}, {
"label": "[혹시 다른 단서는 없었나요?]",
"next_id": "elara_secret_followup2"
}],
"speaker": "엘라라",
"text": "그 기록에 대해서 더 생각해봤나?"
}, {
"id": "elara_secret_followup2",
"is_decisive": false,
"options": [],
"speaker": "엘라라",
"text": "글쎄... 기록 마지막 장에 이상한 문양이 하나 그려져 있긴 했어. 무슨 뜻인지는 나도 몰라."
}]
dialogue_start_id = "elara_greeting"
met_flag_name = "met_elara"

[node name="Rohan" parent="." unique_id=827381515 instance=ExtResource("4_npc")]
position = Vector2(-94, -417)
script = ExtResource("6_rohan")
dialogue_tree = [{
"id": "rohan_locked_greeting",
"is_decisive": false,
"options": [],
"speaker": "로한",
"text": "...넌 누구지? 처음 보는 얼굴이군. 볼일 있으면 나중에."
}, {
"id": "rohan_greeting",
"is_decisive": false,
"options": [{
"label": "[동굴에 대해 묻는다]",
"next_id": "rohan_cave"
}, {
"label": "[숲에 대해 묻는다]",
"next_id": "rohan_forest"
}, {
"label": "[사냥은 잘 되냐고 묻는다]",
"next_id": "rohan_smalltalk"
}, {
"label": "[오크 처치를 돕겠다고 한다]",
"next_id": "rohan_quest_accept",
"show_if_quest_inactive": "forest_orcs",
"start_quest": "forest_orcs"
}, {
"label": "[오크는 어떻게 되어가요?]",
"next_id": "rohan_quest_status",
"show_if_quest_active": "forest_orcs"
}, {
"label": "[다른 사람들에 대해 묻는다]",
"next_id": "rohan_gossip",
"show_if_flag": "met_elara"
}, {
"label": "[뭔가 고민이 있어 보여요]",
"next_id": "rohan_secret_intro",
"required_affinity": {
"min": 60,
"npc_id": "rohan"
},
"show_if_not_seen": "rohan_secret_end"
}, {
"label": "[오크 얘기, 또 생각났나 보군]",
"next_id": "rohan_secret_followup",
"show_if_seen": "rohan_secret_end"
}, {
"give_gift": {
"amount": 9,
"next_id_fail": "rohan_gift_none",
"next_id_success": "rohan_gift_thanks",
"npc_id": "rohan"
},
"label": "[선물을 준다]"
}],
"speaker": "로한",
"text": "거기 서. ...아, 마을에서 온 사람이군.",
"text_by_affinity_tier": {
"cold": "...뭐야. 볼일 있으면 빨리 말해.",
"neutral": "거기 서. ...아, 마을에서 온 사람이군.",
"npc_id": "rohan",
"trusted": "왔나. 자네랑 얘기하는 게 요즘 낙이야, 이거.",
"warm": "왔군. 요즘 자네 발소리는 구별이 되더라고."
}
}, {
"id": "rohan_gift_thanks",
"is_decisive": false,
"options": [],
"speaker": "로한",
"text": "...나한테 선물을? 흠. ...고맙군. 이런 거, 오랜만이라 좀 어색하네."
}, {
"id": "rohan_gift_none",
"is_decisive": false,
"narration": "(막상 건넬 것이 없다)",
"options": [],
"speaker": "로한",
"text": "줄 게 없네요."
}, {
"id": "rohan_quest_accept",
"is_decisive": false,
"options": [],
"speaker": "로한",
"text": "고맙군. 숲에 오크 세 마리가 설치고 있어. 놈들을 처치해주면 마을이 한결 안전해질 거야. 조심하고."
}, {
"id": "rohan_quest_status",
"is_decisive": false,
"options": [],
"speaker": "로한",
"text": "오크를 전부 처리했다고? ...대단하군. 정말 고생 많았어.",
"text_false": "아직 놈들이 숲에 남아있군. 무리하지 말고 조심해.",
"text_if_flag": "forest_quest_complete"
}, {
"affinity_change_on_show": {
"amount": 2,
"npc_id": "rohan",
"once": true
},
"id": "rohan_cave",
"is_decisive": false,
"options": [{
"label": "[위험한가요?]",
"next_id": "rohan_cave_danger"
}, {
"label": "[뭘 봤나요?]",
"next_id": "rohan_cave_saw"
}],
"speaker": "로한",
"text": "저 안에 뭔가 있어. 며칠 전부터 이상한 기운이 느껴져."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "rohan",
"once": true
},
"id": "rohan_cave_danger",
"is_decisive": false,
"options": [{
"label": "[직감을 믿는 편인가요?]",
"next_id": "rohan_cave_instinct"
}, {
"label": "[알겠어요, 조심할게요]",
"next_id": ""
}],
"speaker": "로한",
"text": "몰라. 하지만 내 직감은 조심하라고 말하고 있어."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "rohan",
"once": true
},
"id": "rohan_cave_instinct",
"is_decisive": false,
"options": [],
"speaker": "로한",
"text": "숲에서 오래 살다 보면... 직감 말곤 믿을 게 없어질 때가 있지."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "rohan",
"once": true
},
"id": "rohan_cave_saw",
"is_decisive": false,
"options": [{
"label": "[없애야겠네요]",
"next_id": "rohan_opinion_fight"
}, {
"label": "[먼저 얘기를 해봐야겠어요]",
"next_id": "rohan_opinion_talk"
}],
"speaker": "로한",
"text": "똑똑히는 못 봤어. 그림자 같은 게 물길을 막고 있는 것 같더군."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "rohan",
"once": true
},
"id": "rohan_opinion_fight",
"is_decisive": false,
"options": [{
"label": "[당신도 같이 가줄 건가요?]",
"next_id": "rohan_opinion_fight_join"
}, {
"label": "[알겠어요]",
"next_id": ""
}],
"speaker": "로한",
"text": "그래, 내 생각도 그래. 위험한 건 없애는 게 맞지."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "rohan",
"once": true
},
"id": "rohan_opinion_fight_join",
"is_decisive": false,
"options": [],
"speaker": "로한",
"text": "...아니. 이건 자네 몫이야. 난 마을을 지켜야지."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "rohan",
"once": true
},
"id": "rohan_opinion_talk",
"is_decisive": false,
"options": [{
"label": "[왜 그렇게 생각해요?]",
"next_id": "rohan_opinion_why"
}, {
"label": "[알겠어요]",
"next_id": ""
}],
"speaker": "로한",
"text": "...흠. 그것도 나쁘지 않은 생각이군. 나라면 안 그러겠지만."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "rohan",
"once": true
},
"id": "rohan_opinion_why",
"is_decisive": false,
"options": [],
"speaker": "로한",
"text": "위험한 건 위험한 거야. 대화로 풀릴 거였으면 애초에 이런 일이 안 생겼겠지."
}, {
"affinity_change_on_show": {
"amount": 2,
"npc_id": "rohan",
"once": true
},
"id": "rohan_forest",
"is_decisive": false,
"options": [{
"label": "[구체적으로 뭐가 이상한가요?]",
"next_id": "rohan_forest_detail"
}, {
"label": "[알겠어요]",
"next_id": ""
}],
"speaker": "로한",
"text": "조심해서 다녀. 요즘 숲이 심상치 않아."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "rohan",
"once": true
},
"id": "rohan_forest_detail",
"is_decisive": false,
"options": [],
"speaker": "로한",
"text": "나무들이... 말라가고 있어. 원래 이 계절엔 이러지 않는데."
}, {
"affinity_change_on_show": {
"amount": 2,
"npc_id": "rohan",
"once": true
},
"id": "rohan_smalltalk",
"is_decisive": false,
"options": [{
"label": "[짐승들이 왜 숨었을까요?]",
"next_id": "rohan_smalltalk_animals"
}, {
"label": "[그럼 뭘 드시고 사세요?]",
"next_id": "rohan_smalltalk_food"
}],
"speaker": "로한",
"text": "사냥? ...요즘은 예전만 못해. 짐승들도 뭔가 눈치챈 건지 다들 숨어버렸어."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "rohan",
"once": true
},
"id": "rohan_smalltalk_animals",
"is_decisive": false,
"options": [],
"speaker": "로한",
"text": "글쎄. 짐승은 사람보다 먼저 위험을 아는 법이지."
}, {
"affinity_change_on_show": {
"amount": 1,
"npc_id": "rohan",
"once": true
},
"id": "rohan_smalltalk_food",
"is_decisive": false,
"options": [],
"speaker": "로한",
"text": "걱정 마. 굶어 죽을 정도는 아니니까."
}, {
"id": "rohan_gossip",
"is_decisive": false,
"options": [{
"label": "[엘라라는 어떤 분인가요?]",
"next_id": "rohan_about_elara",
"show_if_flag": "met_elara"
}, {
"label": "[유서프를 아세요?]",
"next_id": "rohan_about_yusuf",
"show_if_flag": "met_yusuf"
}],
"speaker": "로한",
"text": "[다른 사람들에 대해 물어본다]"
}, {
"id": "rohan_about_elara",
"is_decisive": false,
"options": [],
"speaker": "로한",
"text": "장로님은... 이 마을에서 제일 오래 버틴 분이야. 함부로 대하지 마."
}, {
"id": "rohan_about_yusuf",
"is_decisive": false,
"options": [],
"speaker": "로한",
"text": "그 상인? 나쁜 사람은 아닌데... 뭘 숨기고 있는 느낌이야."
}, {
"id": "rohan_secret_intro",
"is_decisive": false,
"options": [{
"label": "[무슨 생각이요?]",
"next_id": "rohan_secret_1"
}, {
"label": "[말하기 싫으면 안 해도 돼요]",
"next_id": ""
}],
"speaker": "로한",
"text": "...티가 나나. 하긴, 요즘 계속 그 생각뿐이라."
}, {
"id": "rohan_secret_1",
"is_decisive": false,
"next_id": "rohan_secret_2",
"speaker": "로한",
"text": "오크들 말이야. 처음엔 그냥 사나워진 줄 알았는데... 요즘 보면 뭔가 이상해."
}, {
"id": "rohan_secret_2",
"is_decisive": false,
"options": [{
"label": "[오크들도 피해자라는 건가요?]",
"next_id": "rohan_secret_3"
}, {
"label": "[그래도 위험한 건 위험한 거잖아요]",
"next_id": "rohan_secret_alt"
}],
"speaker": "로한",
"text": "눈빛이... 짐승의 눈빛이 아니야. 뭔가에 쫓기는 것 같은, 그런 눈이더군."
}, {
"affinity_change_on_show": {
"amount": 3,
"npc_id": "rohan"
},
"id": "rohan_secret_3",
"is_decisive": false,
"next_id": "rohan_secret_end",
"speaker": "로한",
"text": "...그럴지도 모르지. 근데 이런 말 마을에서 함부로 못 해. '괴물 편드는 놈'이라는 소리 듣기 딱 좋으니까."
}, {
"affinity_change_on_show": {
"amount": 2,
"npc_id": "rohan"
},
"id": "rohan_secret_alt",
"is_decisive": false,
"next_id": "rohan_secret_end",
"speaker": "로한",
"text": "맞아. 그건 그거고. 그래도... 가끔은 마음이 편치 않아."
}, {
"id": "rohan_secret_end",
"is_decisive": false,
"options": [],
"speaker": "로한",
"text": "아무튼. 자네한테만 하는 말이야. 알겠지?"
}, {
"id": "rohan_secret_followup",
"is_decisive": false,
"options": [{
"label": "[오크들이 왜 그렇게 됐을까요?]",
"next_id": "rohan_secret_followup2"
}, {
"label": "[아니, 그냥 안부 물으러 왔어요]",
"next_id": ""
}],
"speaker": "로한",
"text": "오크 얘기, 또 생각났나 보군."
}, {
"id": "rohan_secret_followup2",
"is_decisive": false,
"options": [],
"speaker": "로한",
"text": "낸들 알겠나. 근데... 숲 저 안쪽, 자네가 아직 안 가본 데서 뭔가 이상한 냄새가 나더군. 타는 냄새 같기도 하고."
}]
dialogue_start_id = "rohan_greeting"
met_flag_name = "met_rohan"

[node name="Yusuf" parent="." unique_id=1210193695 instance=ExtResource("4_npc")]
position = Vector2(-429, -25)
script = ExtResource("7_yusuf")
dialogue_tree = [{
"id": "yusuf_locked_greeting",
"is_decisive": false,
"options": [],
"speaker": "유서프",
"text": "오, 낯선 얼굴이군? ...아직은 자네한테 해줄 얘기가 없네. 나중에 보지."
}, {
"id": "yusuf_greeting",
"is_decisive": false,
"options": [{
