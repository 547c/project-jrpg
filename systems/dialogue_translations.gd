extends RefCounted

# 대사 번역 테이블. dialogue_data.gd는 손대지 않고(기존 한국어 텍스트가 계속 기본값으로 남음),
# 여기서 노드 id를 키로 번역만 얹는다. 키가 없으면 dialogue_box가 한국어 원문으로 그대로 폴백한다.
#
# 키 형식:
#   "<node_id>"             일반 text
#   "<node_id>:narration"   지문
#   "<node_id>:cold|neutral|warm|trusted"  text_by_affinity_tier 노드의 구간별 대사
#   "<node_id>:true|false"  text_if_flag / text_false 노드의 분기별 대사

const EN: Dictionary = {
	"start": "[Test line 1] Branch choice example",
	"branch_a": "[Test line 2A] Line continuing from choice A",
	"branch_b": "[Test line 2B] Line continuing from choice B",
	"decisive_example": "[Test decisive line] Picking one of the two options below sets the flag itself",
	"elara_greeting:cold": "...What is it.",
	"elara_greeting:neutral": "Ah, it's you. Here about the well, I imagine.",
	"elara_greeting:warm": "You've come. Seeing you puts my mind at ease.",
	"elara_greeting:trusted": "I'm glad you're here. These days your face alone is a comfort.",
	"elara_bounty_intro": "Good, you're here. There are a few bounties villagers have posted. Take a look if you have the time.",
	"elara_gift_thanks": "For me...? Ha, thank you. It warms an old woman's heart.",
	"elara_gift_none:narration": "(nothing to give, it turns out)",
	"elara_gift_none": "I don't have anything to give.",
	"elara_well": "Yes, you'd be wondering about that. The village has been in quite a state these past few days.",
	"elara_well_incident": "It was three nights ago... just past midnight, I believe. The whole village shook with a great CRASH! More than a few of us were startled awake. Myself included.",
	"elara_well_light": "Right after that, the sky near the cave turned strange for a moment. I didn't see it myself, but a few people who were still up late said they did — a pale blue light, unlike anything of this world.",
	"elara_well_dry": "And the next morning, if you can believe it, the well-keeper lowered the bucket and it came up empty all the way to the bottom. It happened overnight. Not once, since this village was founded, has the well ever run dry.",
	"elara_well_react_a": "I thought the same at first. Droughts happen. But overnight, along with that light and the tremor... it's too much to be coincidence.",
	"elara_well_react_b": "You felt it too, then. So did I. You live long enough, you see strange things now and then, but this one was different.",
	"elara_well_altar": "Actually, there's a story about this cave that's been passed down in the village for a very long time. Have you seen that stone altar?",
	"elara_well_legend": "In the old days, villagers used to leave water and flowers there. They called it \"an offering to the Warden.\" I remember going a few times as a child, holding my grandmother's hand. No one does it anymore.",
	"elara_well_legend2": "As for what the Warden is — they said it's a being that watches over the water flowing beneath this land. Sleeping deep in the cave, keeping our water from running dry. Everyone always thought it was just an old story — myself included. But after what's happened... I can't quite say that anymore.",
	"elara_well_puzzle": "I don't know. But isn't it strange? If it's meant to protect us, why would it suddenly block the water? It doesn't add up. Still, something's clearly going on, so we ought to find out.",
	"elara_well_send_rohan": "I'd rather you didn't go alone... but I suppose you can handle it. Still, prepare well before you go. Start with Rohan — he practically lives out in the forest, and he stopped by this morning saying he was nearby that night. White as a sheet, he was.",
	"elara_well_send_mia": "Ah, and... I don't know if you've heard about Mia. Her mother came to me yesterday, worried sick. The girl was out that night too. Everyone knew she sometimes wanders at night — she's never slept well — but that night she came running back in tears before dawn, and she's barely spoken since. Go gently with her; even the adults are on edge right now.",
	"elara_well_send_yusuf": "And you should go see Yusuf in the market too. I overheard him talking about this with people yesterday — he seemed to know something. He's a traveling merchant, so he might know if something similar has happened in other villages.",
	"elara_ending_check:narration": "(Village square, at night)",
	"elara_ending_check": "(relieved the moment she sees you) You made it back safe! ...How did it go with the well?",
	"elara_ending_fight_1:narration": "(a sigh of relief, though her expression isn't fully at ease)",
	"elara_ending_fight_1": "You defeated it... that's a relief. A real relief.",
	"elara_ending_fight_2:narration": "(her expression tightens)",
	"elara_ending_fight_2": "...What do you mean by that.",
	"elara_ending_fight_3:narration": "(a long silence)",
	"elara_ending_fight_3": "The legend I know ends there. I don't know anything beyond that. But... if what you heard wasn't your imagination, this story might run far deeper than we ever knew.",
	"elara_ending_peace_1": "Resolved it, you say... how did you manage that?",
	"elara_ending_peace_2:narration": "(startled)",
	"elara_ending_peace_2": "It spoke... like a person? It wasn't alive?",
	"elara_ending_peace_3:narration": "(her expression turns serious)",
	"elara_ending_peace_3": "...Bound. That means it wasn't something that was always there — someone shut it away. A person, no less. ...And \"the Watchers,\" you say — I've never heard that name before.",
	"elara_ending_peace_4:narration": "(as if speaking to herself, then looking at the player)",
	"elara_ending_peace_4": "Who would do such a thing, and why... I'm sorry, I don't know any more than that. But remember those words — \"the Watchers\" and \"underground.\" They don't sound like nothing.",
	"elara_ending_water_1:narration": "(startled, turning to look at the well)",
	"elara_ending_water_1": "...Now that you mention it, everyone's been saying the well's water level rose strangely high this evening. Is this how much? ...This isn't the amount of water we've ever known.",
	"elara_ending_water_2": "I don't know what this means, honestly. But this clearly isn't just our village's problem. Go see Yusuf again. I think you'll need to press him harder than before.",
	"elara_ending_trigger": "...Yes. I suppose we'll have to keep watch now.",
	"elara_village": "A small place. But it's stood here for over a hundred years.",
	"elara_village_old": "That means it's seen a great deal. Good things, and bad.",
	"elara_village_peace": "Peace... yes, that's how it's been, up to now.",
	"elara_smalltalk": "Asking after me, how kind. Are you keeping well?",
	"elara_smalltalk_fine": "Good to hear. A village is only as strong as its young.",
	"elara_smalltalk_tired": "Take it easy. The well can wait — don't wear yourself out over it.",
	"elara_gossip": "[Ask about the others]",
	"elara_about_rohan": "Blunt, but he cares for this village. No one knows the forest better.",
	"elara_about_yusuf": "Trustworthy? Hard to say. Yusuf's problem is he knows too much.",
	"elara_about_mia": "That child... she saw something frightening not long ago. Don't press her.",
	"elara_secret_intro": "Curious, are you... hmm, I suppose it's fine to tell someone like you.",
	"elara_secret_1": "The truth is... I inherited something from the elder before me. A very old record.",
	"elara_secret_2": "It says this isn't the first time something like this has happened. Long, long ago, the water ran dry once before.",
	"elara_secret_3": "The record just says it 'passed.' It doesn't say how they solved it. Or maybe... it couldn't be written down.",
	"elara_secret_alt": "You know how it is — people scare easily. I didn't want to unsettle the village over something uncertain.",
	"elara_secret_end": "...Anyway, I'm only telling you this because it's you. Keep it to yourself, for now.",
	"elara_secret_followup": "Have you given any more thought to that record?",
	"elara_secret_followup2": "Well... there was one strange symbol drawn on the last page. I have no idea what it means.",
	"elara_secret_stage2_1:narration": "(opening the book again)",
	"elara_secret_stage2_1": "Actually... there's something odd every time I look at it. Here, this part.",
	"elara_secret_stage2_2": "It reads: \"Water overflowed day and night, and no villager ever knew thirst.\" At first I thought it was just exaggeration.",
	"elara_secret_stage2_3": "But lately, talking with you about all this... what if it wasn't an exaggeration at all? What if the amount of water we know now is only a fraction of what it should be?",
	"elara_secret_stage2_4:narration": "(shaking her head)",
	"elara_secret_stage2_4": "...I don't even know what I'm saying anymore. It's just, this record's been weighing on my mind lately.",
	"elara_grind_advice_1:narration": "(Her expression turns serious the moment she sees you.)",
	"elara_grind_advice_1": "...So you've spoken with all of them. I can tell just by looking at you.",
	"elara_grind_advice_2": "Yes, I've heard bits of it myself. Since you're all telling the same story about that night, one thing's clear — this isn't something to brush aside.",
	"elara_grind_advice_3:narration": "(with worried eyes)",
	"elara_grind_advice_3": "If you're thinking of going into that cave... I won't stop you, but don't take it lightly. Prepare yourself well. I hear the monsters in the forest and cave have gotten fiercer lately, too.",
	"elara_grind_advice_end": "...Right, I can't just walk in unprepared. I need to grow stronger first.",
	"rohan_locked_greeting": "...Who are you? Never seen your face before. Come back if you need something.",
	"rohan_greeting:cold": "...What. If you need something, make it quick.",
	"rohan_greeting:neutral": "Stop right there. ...Ah, someone from the village.",
	"rohan_greeting:warm": "You're here. These days I can tell your footsteps apart from the rest.",
	"rohan_greeting:trusted": "Good, you came. Talking with you's become one of the better parts of my day.",
	"rohan_gift_thanks": "...A gift, for me? Hm. ...Thanks. It's been a while since anyone's done that — feels a bit strange.",
	"rohan_gift_none:narration": "(nothing to give, it turns out)",
	"rohan_gift_none": "I don't have anything to give.",
	"rohan_quest_accept": "Appreciate it. There are three orcs causing trouble in the forest. Take care of them and the village will be a lot safer. Be careful out there.",
	"rohan_quest_status:true": "You cleared out every last orc? ...Impressive. That was no small task.",
	"rohan_quest_status:false": "They're still out there in the forest. Don't push yourself — be careful.",
	"rohan_cave:narration": "(sighs)",
	"rohan_cave": "That night, you mean. ...Sit down, it's a long story.",
	"rohan_cave_3": "These past few weeks, foxes and wildcats alike keep coming down toward the village henhouses. This time of year there's usually plenty of food in the forest, so it shouldn't happen. That's why I doubled the night patrols — which is why I was out so late that night.",
	"rohan_cave_4": "Must've been just past midnight. Light burst out near the cave mouth, and the ground shook. I nearly fell over.",
	"rohan_cave_5": "But what really chilled me was what came after. Every animal nearby bolted like mad. Birds flew up in flocks in the middle of the night, and a fox ran right past me — didn't even flinch at the sight of me. I've hunted this forest for over ten years, and I'd never seen anything like it.",
	"rohan_cave_6": "The Warden, you mean? I heard the stories as a kid. Never really believed them, though — just figured it was something to scare children with. \"Go near the cave at night and the Warden will get you,\" that sort of thing. But... after what I saw that night, I'm not so sure anymore.",
	"rohan_cave_7": "I did, at first. But I stopped after a few steps. It's hard to explain... the light didn't feel frightening so much as strangely sad. There was a sound too, low and drawn out. Not an animal's cry, and not quite human either. I still don't know what it was.",
	"rohan_cave_end": "Anyway, I haven't gone near that cave since. Don't go alone either. Ask Yusuf too — he travels around, he might know if this has happened elsewhere.",
	"rohan_forest": "Be careful out there. The forest's been off lately.",
	"rohan_forest_detail": "The trees... they're withering. Shouldn't be happening this time of year.",
	"rohan_smalltalk": "Hunting? ...Not what it used to be. Feels like the animals have caught on to something and gone into hiding.",
	"rohan_smalltalk_animals": "Hard to say. Animals sense danger before people do.",
	"rohan_smalltalk_food": "Don't worry. It's not bad enough that anyone's going hungry.",
	"rohan_gossip": "[Ask about the others]",
	"rohan_about_elara": "The elder's... lasted longer in this village than anyone. Show her some respect.",
	"rohan_about_yusuf": "That merchant? Not a bad sort, but I get the feeling he's hiding something.",
	"rohan_secret_intro": "...That obvious, huh. Well, it's all I've been thinking about lately.",
	"rohan_secret_1": "The orcs. At first I figured they'd just turned savage. But lately... something's off about them.",
	"rohan_secret_2": "The look in their eyes — it isn't an animal's look. More like something being hunted. That kind of look.",
	"rohan_secret_3": "...Maybe. But that's not something you say around the village. Good way to get called an 'orc-lover.'",
	"rohan_secret_alt": "You're right, that's true enough. Still... it doesn't sit right with me sometimes.",
	"rohan_secret_end": "Anyway. This stays between us, understood?",
	"rohan_secret_followup": "Thinking about the orcs again, are you.",
	"rohan_secret_followup2": "Couldn't say. But... deeper in the forest, somewhere you haven't been, there's a strange smell. Something like burning.",
	"rohan_secret_stage2_1": "Back then? I never saw it myself... but there's something that's been passed down in my family for generations. A hunting record going back to my grandfather's grandfather, or further.",
	"rohan_secret_stage2_2:narration": "(pulling an old book from his coat)",
	"rohan_secret_stage2_2": "It's got hunting methods, animal habits, all sorts of things written in it... but every so often you run into a passage that's hard to believe.",
	"rohan_secret_stage2_3": "Tree trunks so wide three grown men couldn't wrap their arms around them, fruit the size of — well, huge. First time I read it, I figured it was just old exaggeration.",
	"rohan_secret_stage2_4": "But the real strange part is the wolves. These days one wolf's something even I can handle alone — common enough. But the record talks about wolves so strong it took a whole party of hunters to bring one down. Said the meat from a single kill would feed the entire village.",
	"rohan_secret_stage2_5:narration": "(putting the book away again)",
	"rohan_secret_stage2_5": "Even my grandfather used to scratch his head reading that part. \"What era is this even from, it doesn't match anything now,\" he'd say. I feel the same way. Never did find an answer, though.",
	"yusuf_locked_greeting": "Oh, an unfamiliar face? ...Nothing I can tell you yet. Come back another time.",
	"yusuf_greeting:cold": "...Yeah? Need something?",
	"yusuf_greeting:neutral": "Ah, a customer! Looking for anything in particular?",
	"yusuf_greeting:warm": "Oh, you're here! Seeing your face has become the best part of my day.",
	"yusuf_greeting:trusted": "You've come. ...Honestly, I feel like I can be a bit more honest with you these days.",
	"yusuf_gift_thanks": "Oh, my! A gift, for a merchant? Ha, I won't forget this kindness.",
	"yusuf_gift_none:narration": "(nothing to give, it turns out)",
	"yusuf_gift_none": "I don't have anything to give.",
	"yusuf_quest_accept": "Ah, glad to have the help! There are three skeletons lurking around the cave entrance. Deal with them and I'll make it worth your while.",
	"yusuf_quest_not_ready": "Doesn't look like you're quite ready yet. Build up your strength first, then come back.",
	"yusuf_quest_status:true": "Skeletons all taken care of? Just as I'd expect from you. I'll pay you well, as promised.",
	"yusuf_quest_status:false": "Still some of them left in the cave. No rush — just make sure the job's done right.",
	"yusuf_cave_hint:narration": "(the smile fading slightly)",
	"yusuf_cave_hint": "The cave, huh... is this about the well, by any chance?",
	"yusuf_cave_hint2:narration": "(pausing while packing his things)",
	"yusuf_cave_hint2": "...There was. Actually, this isn't the first time I've heard something like this.",
	"yusuf_cave_hint3": "A couple of months back, I passed through a village well south of here. Heard the exact same story there. The well ran dry overnight, and everyone saw strange lights. I brushed it off as some common superstition at the time.",
	"yusuf_cave_q2": "No idea. I only stayed three days before moving on to the next village. A passing merchant can't exactly afford to dwell on it.",
	"yusuf_cave_q3:narration": "(shrugging)",
	"yusuf_cave_q3": "A merchant comes to a village for the obvious reasons — things to sell, things to buy. ...But, well, honestly, I've noticed my feet keep leading me to villages like this lately. The ones with bad water.",
	"yusuf_cave_end:narration": "(going back to packing, changing the subject)",
	"yusuf_cave_end": "It's nothing. Just a coincidence, probably. Anyway, have you talked to Rohan or Mia yet? They'd be more help than me. I can only offer a passer-by's perspective.",
	"yusuf_who": "Just... a merchant who wanders from place to place. Anything more than that... you'll find out eventually.",
	"yusuf_who_suspicious": "Suspicious, am I? That stings. ...Well, you're not entirely wrong.",
	"yusuf_wares": "This and that. Goods I've picked up from other villages.",
	"yusuf_other_villages": "Compared to here... some places have it worse. Your village is still one of the lucky ones.",
	"yusuf_gossip": "[Ask about the others]",
	"yusuf_about_elara": "The elder? Wisest person in this village. I've owed her more than a few favors myself.",
	"yusuf_about_rohan": "That hunter? Prickly, but he's someone you can trust.",
	"yusuf_secret_stage1": "...Sharp of you. Well, you're not entirely wrong.",
	"yusuf_secret_stage1b": "I'm... not just someone who sells things. More precisely, I'm someone who travels the world 'keeping watch' on things.",
	"yusuf_secret_stage1c": "That's all I'll say for now. If you're curious for more... trust me a little more first, and I'll tell you.",
	"yusuf_confession_1:narration": "(his expression tightens slightly)",
	"yusuf_confession_1": "...So, I figured you'd come. Tell me what happened.",
	"yusuf_confession_2:narration": "(taking a deep breath)",
	"yusuf_confession_2": "...I see. So it's happened here too, in the end.",
	"yusuf_confession_3:narration": "(a long silence)",
	"yusuf_confession_3": "...All right. I suppose it's really time to tell you. There's something I've never told you.",
	"yusuf_confession_4": "I'm not just some wandering merchant. I used to... work under people called 'the Watchers.'",
	"yusuf_confession_5": "At first I didn't even know it was wrong. They called it \"looking after villages where the Vein was running dry.\" But in one village, I saw the \"filter\" myself — the thing everyone just calls an old device.",
	"yusuf_confession_6:narration": "(a pause)",
	"yusuf_confession_6": "But it wasn't a device. There was a person inside. Couldn't move, couldn't speak properly... but the eyes were still alive. I could tell — it was suffering.",
	"yusuf_confession_7": "I ran that night. Drifted from village to village ever since... not even sure what I was looking for. But the moment I heard about what happened in that cave here, my blood ran cold. The same thing was happening here too.",
	"yusuf_confession_8": "But honestly, I don't know everything either. Whatever I picked up, it was just scraps — things the people above me let slip while I was there.",
	"yusuf_confession_9": "They kept talking about \"collecting\" something. Never said exactly what, or where it went. Made it clear someone at my level didn't need to know.",
	"yusuf_confession_10": "But once, just once, a supervisor who'd had too much to drink let something slip. \"Down there,\" he said, \"there's something you couldn't imagine, even from up here.\" Then he shut his mouth right away.",
	"yusuf_confession_11:narration": "(nodding)",
	"yusuf_confession_11": "Didn't mean anything to me at the time. But hearing your story now... it sends a chill through me.",
	"yusuf_confession_12": "Think about it. We know for certain now that the Warden's been cutting the Vein reaching the village. But what if the part that's cut isn't just disappearing? What if it's going somewhere?",
	"yusuf_confession_13:narration": "(as if not quite believing it himself)",
	"yusuf_confession_13": "...Don't tell me — down there, underground? Have they been siphoning off the Vein this whole time?",
	"yusuf_confession_14:narration": "(shaking his head)",
	"yusuf_confession_14": "That much, I don't know either. Power? Money? ...Or maybe something far bigger. If the Vein isn't just a resource but the source of life itself, I'm almost afraid to imagine what they'd want to hoard it for.",
	"yusuf_confession_15:narration": "(looking at the player)",
	"yusuf_confession_15": "But guessing alone won't get us anywhere. We need proof.",
	"yusuf_confession_16": "The Warden here is gone now — can't exactly ask it. But... in villages that have already dried up completely, the ones turned to desert, there should still be Warden husks left behind. Might find something there.",
	"yusuf_confession_17": "Problem is, it's across the sea. I hear there's a boat at the village dock. That should get us there.",
	"yusuf_confession_end:narration": "(smiling bitterly)",
	"yusuf_confession_end": "I've come too far to back out now anyway. ...All right, let's go together. No running this time.",
	"yusuf_desert_greeting:narration": "(shading his eyes)",
	"yusuf_desert_greeting": "This must've been a village too, once. Though I doubt anyone remembers it now.",
	"yusuf_desert_warden:narration": "(trailing off)",
	"yusuf_desert_warden": "There would've been. But by now, I'd guess...",
	"filter_room_1:narration": "The first mural. A land overflowing with water. People laughing. The trees are far larger than any today, and the river gleams silver.",
	"filter_room_2:narration": "(running a hand over the mural)",
	"filter_room_2": "...So this is what it used to look like.",
	"filter_room_3:narration": "The second mural. People surrounding a single figure. That figure sinks into light. The onlookers' faces are a mix of fear and grief.",
	"filter_room_4:narration": "(silent)",
	"filter_room_4": "...Probably.",
	"filter_room_5:narration": "The third mural. A stairway leading underground. Below, crowned figures hold glowing streams of water in their hands. Their faces never age.",
	"filter_room_6:narration": "(catching his breath)",
	"filter_room_6": "...Those must be the Watchers.",
	"filter_room_7:narration": "(voice trembling)",
	"filter_room_7": "...So that's it. They stole the Vein... to live forever.",
	"filter_room_8:narration": "In the center of the room lies the husk of a Warden, its activity long since ceased. No trace of resistance, no trace of struggle. Just empty.",
	"filter_room_9:narration": "(quietly)",
	"filter_room_9": "Yeah. This one was drained out long ago. Probably didn't have any fight left in it.",
	"filter_room_10": "The least we can do is release the binding. Let's at least do that much.",
	"filter_room_release:narration": "The moment the binding is released, the husk quietly scatters into motes of light. No resistance, no last words. As if something long overdue had simply, finally, ended.",
	"filter_room_waterburst:narration": "At that moment, the same sight from the village unfolds again. The Vein bursts from the cracks in the walls, still holding its ancient color and brightness.",
	"filter_room_11:narration": "(staring, transfixed)",
	"filter_room_11": "...This much. It was this much.",
	"filter_room_12:narration": "(looking at the player)",
	"filter_room_12": "It's certain now... there's only one thing left. Going down there.",
	"filter_room_end:narration": "(bitterly, but resolved)",
	"filter_room_end": "I'm not running this time either. Let's see this through, together.",
	"mia_locked_greeting:narration": "(wary of the stranger, stepping back)",
	"mia_locked_greeting": "...",
	"mia_greeting:narration": "(Village outskirts, by an old wall — Mia crouches alone, drawing something in the dirt with a stick. Startled by the footsteps, she quickly wipes it away) (softly, guarded)",
	"mia_greeting": "...Who are you.",
	"mia_q1:narration": "(still guarded)",
	"mia_q1": "...No reason. You're not... from the village, are you?",
	"mia_q2:narration": "(softening a little)",
	"mia_q2": "...I was looking for Nabi. My cat. She's been missing since yesterday.",
	"mia_q3:narration": "(almost smiling, then tensing again)",
	"mia_q3": "...No. I don't usually come here. I just... ended up here looking for Nabi.",
	"mia_q4:narration": "(flinching, stepping back)",
	"mia_q4": "...How do you know that?",
	"mia_q5:narration": "(looking away, voice getting smaller) (trailing off, burying her face between her knees)",
	"mia_q5": "...That night too, Nabi was missing... I don't sleep well at night, so I sneak out sometimes. But that night, I thought I heard her crying, so I went all the way to the cave.",
	"mia_q6:narration": "(looking up, eyes a little red)",
	"mia_q6": "...Really?",
	"mia_gift_thanks": "Whoa... this is for me? Hehe, thank you! I'll take good care of it.",
	"mia_gift_none:narration": "(nothing to give, it turns out)",
	"mia_gift_none": "I don't have anything to give.",
	"mia_approach_press:narration": "(Mia seems about to say more, but hesitates)",
	"mia_scared:narration": "(eyes widening, shrinking back) (hugging her knees with both arms)",
	"mia_scared": "...I don't know. I didn't see anything.",
	"mia_scared_apology:narration": "(turning her head away) (a long silence, then, very quietly)",
	"mia_scared_apology": "...It's okay. ...Just, a blue light. That's what I saw. That's all. I... don't want to talk anymore.",
	"mia_relieved:narration": "(a little relieved, but still cautious)",
	"mia_relieved": "...You really won't tell anyone? The grown-ups all say I was just scared and imagined things.",
	"mia_relieved_reveal:narration": "(taking a deep breath)",
	"mia_relieved_reveal": "...That night, I followed Nabi all the way to the cave entrance. To where the old stone is. Then suddenly the ground shook, and blue light poured out from inside the cave.",
	"mia_relieved_detail": "I was scared at first... but there was a sound along with the light. Low, going on and on. Not a scary sound — it was... like someone crying. A person crying. That's what scared me more, I think. Not knowing why something like that would be crying in there.",
	"mia_smalltalk:narration": "(Mia looks at you more comfortably than before)",
	"mia_smalltalk": "...",
	"mia_smalltalk_shy": "...I'm okay, I guess.",
	"mia_smalltalk_ok": "I'm not scared anymore. Thanks to you.",
	"mia_smalltalk_close": "I like it when you visit. Feels like I have someone to talk to.",
	"mia_dream_intro": "...That? Actually, even before that night, I used to have a strange dream.",
	"mia_dream_1": "It's a dream about water... glowing. But it was a sad kind of light. Like it was looking for something.",
	"mia_dream_2": "Mom says it's just a kid's dream... but when I actually saw that light for real that night, it felt more familiar than scary.",
	"mia_dream_end": "...Weird, right? Anyway, I'm glad I could tell you.",
	"mia_dream_followup": "I still have that dream sometimes. But... lately the background's different. It's all sand instead of water.",
	"mia_dream_followup2:narration": "(hugging her doll tightly)",
	"mia_dream_followup2": "It used to just be sad, seeing the water sparkle like that... but lately, I hear someone crying too. In the dream.",
	"mia_dream_followup3:narration": "(in a small voice)",
	"mia_dream_followup3": "But if I tell Mom, she'll just say \"it's only a dream\" again. ...Do you think that too?",
	"mia_dream_followup_yes": "...Really? Hearing you say that makes me feel a little better.",
	"mia_dream_followup_no": "...I guess so. ...It's probably just that, huh.",
	"kamil_greeting": "...It's you. The one Yusuf mentioned.",
	"kamil_sister_intro": "...How do you know that name. Ah — you must have met her in the desert.",
	"kamil_sister_1": "That girl is... my sister. We went our separate ways a long time ago.",
	"kamil_sister_2": "I left, and she stayed. She might still resent me for it, for all I know.",
	"kamil_truth_1:narration": "(reading your expression)",
	"kamil_truth_1": "...You saw it. The murals.",
	"kamil_truth_1b:narration": "(silent)",
	"kamil_truth_1b": "...Some of it. Not everything.",
	"kamil_truth_1c": "I'm one of them too. A Watcher. But... ever since I saw my sister again, I haven't been able to feel at ease. Even agreeing to ferry you here felt strange to me, if I'm honest.",
	"kamil_truth_2:narration": "(hesitating)",
	"kamil_truth_2": "...I know the way in. Some of the layout too. But... whether you trust me enough to take that information is up to you.",
	"kamil_truth_3": "I'm still one of them. I can't promise you a hundred percent that what I'd tell you is true, or that it isn't a trap.",
	"kamil_choice_reveal:narration": "(relieved, but with a heavy expression)",
	"kamil_choice_reveal": "...Thank you. I'll make sure you don't regret it. I'll guide you as far as I know, to the entrance underground.",
	"kamil_choice_secret:narration": "(smiling bitterly)",
	"kamil_choice_secret": "...I understand. That's only natural. But be careful — going in without me will be far more dangerous.",
	"kamil_gift_thanks": "...For me? That's unexpected. It's been so long since I've received something like this... thank you.",
	"kamil_gift_none:narration": "(nothing to give, it turns out)",
	"kamil_gift_none": "I don't have anything to give.",
	"kamil_intro_1": "...Kamil. Just think of me as someone doing work similar to Yusuf's.",
	"kamil_intro_2": "If you need anything, let me know. If you're headed for the desert, I'll have the boat ready.",
	"kamil_confirm_departure": "Understood. I'll be waiting at the dock.",
	"nadim_greeting:cold": "...Need something?",
	"nadim_greeting:neutral": "...Another outsider? Did Kamil bring you?",
	"nadim_greeting:warm": "You're here. Having you around puts my mind a little at ease.",
	"nadim_greeting:trusted": "You came. Lately... I feel like I've been holding on thanks to you.",
	"nadim_gift_thanks": "...For me? Didn't expect to receive something like this, in this barren land. Thank you.",
	"nadim_gift_none:narration": "(nothing to give, it turns out)",
	"nadim_gift_none": "I don't have anything to give.",
	"nadim_mummy_accept": "Appreciate it. There are three of those withered things along the path to the ruins. As long as they're there, no one can reach the ruins. Please be careful.",
	"nadim_mummy_status:true": "Mummies all taken care of? ...You're something else. Really, thank you.",
	"nadim_mummy_status:false": "Those withered things are still out there. Don't push yourself.",
	"nadim_key_accept": "The ruins' door won't open without the key. The old ones must have hidden it somewhere near here. Search carefully.",
	"nadim_key_status:true": "Found the key, did you. Then... we can really go now.",
	"nadim_key_status:false": "Still haven't found the key, I take it. The ruins' door won't budge without it.",
	"nadim_intro_1": "Help, is it... might be too late already, but I'm grateful you came.",
	"nadim_intro_2": "This land wasn't always like this. It's been drying up slowly for years now. Just like your village's well.",
	"nadim_backstory_1": "There are... old ruins nearby. Said to be a place where the ancients once controlled the flow of water.",
	"nadim_backstory_2": "No one who's gone deep into those ruins has ever come back. Still... I think that's the only place we'll find answers.",
	"nadim_quest_offer": "Thank you. Be careful. The ruins' entrance is east of the settlement.",
	"nadim_secret_intro": "...I knew you'd ask about that eventually.",
	"nadim_secret_1": "Those withered things... they used to be ordinary creatures around here. Just a bit fiercer than most.",
	"nadim_secret_2": "But at some point they turned noticeably savage. Attacking anything in sight, for no reason.",
	"nadim_secret_3": "There's a rumor that people like Kamil started showing up around the same time.",
	"nadim_secret_4": "Can't say for certain. Nothing's certain. But... maybe you'll find something out, once you're inside the ruins.",
	"nadim_secret_alt": "Maybe so. It's just... it's been bothering me, strangely enough.",
	"nadim_secret_end": "Don't mention this to Kamil yet. Not until we're sure.",
	"nadim_sister_intro": "...You're asking about my sister.",
	"nadim_sister_1": "We were sisters. She chose to leave, and I chose to stay.",
	"nadim_sister_2": "Sometimes... I think she might have been right. But I don't regret it.",
	"kasim_greeting": "...A customer. Hard to meet your eyes from under this hood, but, well, business is business.",
	"kasim_gift_thanks": "...For me? Guess my expression shows even under the hood. I'll gladly take it.",
	"kasim_gift_none:narration": "(nothing to give, it turns out)",
	"kasim_gift_none": "I don't have anything to give.",
	"kasim_wares": "Don't let the look fool you — I've got some solid gear. Wood, bone, even gold-tier.",
	"kasim_intro_1": "Name's Kasim. I wander around selling things — nothing more dramatic than that.",
	"kasim_intro_2": "...Ha. Sharp eye. Well, there's a reason I keep this hood on.",
	"kasim_intro_3": "Beyond that... don't ask. Maybe I'll tell you, when the time's right.",
	"kasim_smalltalk_1": "Can't complain. Didn't expect customers to find their way to a village this remote, though.",
	"kasim_smalltalk_2": "Boredom... you get used to it, after living long enough. Ah — don't mind that, just talking.",
	"guardian_entrance:narration": "(An old stone altar sits at the entrance. Long-withered flowers and a few faded bowls still rest upon it. From deeper within, a faint but unmistakable blue light seeps out.)",
	"guardian_intro_1:narration": "(The old carvings on the walls glow faintly in the blue light. Traces of flowing water lie dried across the floor. Deeper within, a massive shape crouches, groaning low.) (Sensing a presence, the shape slowly lifts its head. A blinding light bursts out, and a long, low cry like a wail echoes through the cave.)",
	"guardian_intro_2": "...Who's there. ...Here to destroy me too?",
	"guardian_intro_3": "The water... I didn't block it. I was only ever... protecting it. Something went wrong. Even I... don't know why it's like this.",
	"guardian_decisive:narration": "(The Guardian lowers itself. It could be readying to fight — or it could be resigned.)",
	"guardian_fight_result:narration": "(The shape staggers violently and collapses. The light fades rapidly.)",
	"guardian_fight_result": "...It's over... ...I'm... sorry...",
	"guardian_fight_aftermath:narration": "(As it collapses completely, the remaining light scatters. At that moment, water begins bursting from cracks in the walls. What starts as a trickle quickly becomes a heavy stream, filling the cave floor. Clear water, tinged with a pale blue glow.)",
	"guardian_peace_1:narration": "(The shape rises as if to threaten, then suddenly convulses unnaturally and curls back up. As if fighting itself.)",
	"guardian_peace_2:narration": "(The shape freezes. It growls low, but doesn't come any closer.)",
	"guardian_peace_2b:narration": "(The shape shudders violently, letting out an incomprehensible sound. Between the groans, something like human words seems to slip through.)",
	"guardian_peace_2b": "...Not... supposed to... it said...",
	"guardian_peace_2c:narration": "(The shape suddenly goes completely still. As if meeting, for the first time, someone who understood its words.)",
	"guardian_peace_2c": "...That's right... breaking it... hurts... but... I can't... not this time... I can't...",
	"guardian_peace_2d:narration": "(The groaning quiets for a moment, then thrashes violently again — caught between the command and its own resistance.)",
	"guardian_peace_calm:narration": "(The thrashing gradually settles. Still unable to fully let go, the once-massive shape wavers and slowly shrinks into something closer to a human outline.)",
	"guardian_peace_calm": "...How long... has it been. Since I was bound here...",
	"guardian_peace_gaze:narration": "(The shape lifts its head and gazes at the player for a long moment, as if weighing something.)",
	"guardian_peace_gaze": "...I sense something, from you. ...Yes. This is enough. I can leave the rest to you.",
	"guardian_peace_3:narration": "(At that moment, the outline begins to scatter into particles of light. It isn't resting. It's disappearing.)",
	"guardian_peace_3": "Thank you... truly... thank you...",
	"guardian_peace_farewell:narration": "(Before it can finish speaking, the last particles of light scatter completely. Nothing remains where it stood. And at that same moment, water begins bursting from cracks in the walls. What starts as a trickle quickly becomes a heavy stream, filling the cave floor. Clear water, tinged with a pale blue glow.)",
	"guardian_peace_farewell": "...The Watchers... are underground... they're... all of them...",
	"guardian_mono_fight_1:narration": "(Outside the cave, at dusk — the player steps out. The faint sound of running water lingers behind them.)",
	"guardian_mono_fight_1": "...It said sorry. As it fell, at the very end.",
	"guardian_mono_fight_2": "A monster... wouldn't say something like that. No, was that even really a monster to begin with?",
	"guardian_mono_fight_3": "Maybe I had it wrong, all along.",
	"guardian_mono_peace_1:narration": "(Outside the cave, at dusk — the player steps out. The faint sound of running water lingers behind them.)",
	"guardian_mono_peace_1": "...It said thank you. And it asked — how long. Since it was bound.",
	"guardian_mono_peace_2": "Bound, it said...? So it wasn't something that was always there — someone shut it away.",
	"guardian_mono_peace_3": "The voice, and the shape right before it vanished... that was a person. Definitely.",
	"guardian_mono_peace_4": "Why would a person be trapped in there, and what did they go through.",
	"guardian_mono_peace_5": "...And at the end, it said 'the Watchers are underground.' Before it could even finish.",
	"guardian_mono_peace_6": "The Watchers. Underground. What could that even be... to trap a person here and do something like this.",
	"guardian_mono_water_1:narration": "(Looking down at the water rising to their feet. The cave has become a shallow sea in an instant.)",
	"guardian_mono_water_1": "...It was just one well that ran dry. But this — this is more than that.",
	"guardian_mono_water_2": "The Vein, was it. This much could come out of it? This is nothing like the water the village has ever known.",
	"guardian_mono_water_3": "So then, what we've been using all this time... what was that, exactly.",
	"guardian_mono_water_4": "I should go tell Elder Elara. Not sure how I'll explain it, but I need to.",
	"opening_1:narration": "Long ago, an unseen, ancient current flowed through the deepest places of the earth.",
	"opening_2:narration": "People called it the Vein, and the forests, the fields, and humankind alike drew breath, leaning on that blue flow.",
	"opening_3:narration": "When did the Vein — which seemed as if it would flow forever — begin to stop? Where it ran dry, plague spread, and the land let out a parched scream.",
	"opening_4:narration": "This is the story of Orsia, a quiet village on the margins that news of the ruin never reached — beginning as even its last Vein finally runs dry—",
	"opening_5:narration": "The first page, of one boy's story.",

	"ruins_boss_greeting:narration": "(in a mechanical voice)",
	"ruins_boss_greeting": "...Unauthorized. Withdraw.",
	"ruins_boss_repeat:narration": "(The Gatekeeper shows no reaction, only repeating the same words. There's no getting through to it — this thing, too, seems to have lost its humanity long ago.)",
	"ruins_boss_repeat": "...Unauthorized. Withdraw.",
	"ruins_boss_aftermath_1:narration": "(looking down at the Gatekeeper)",
	"ruins_boss_aftermath_1": "...Was this one a person too, once.",
	"ruins_boss_aftermath_end:narration": "(nodding)",
	"ruins_boss_aftermath_end": "...Let's go.",

	"ruins_lore_intro:narration": "A carving is etched into the wall: people paying respect to beings that watch over the water's flow. Beside it, a record written in unfamiliar characters.",
	"ruins_lore_1": "...Hard to translate, but a few words are recognizable: 'binding,' 'Watcher,' 'mistake.'",
	"ruins_lore_2": "The last line reads: 'What we sought to contain was, in the end, set free by our own hands.'",

	"campfire_ask:narration": "The campfire burns warmly.",
	"campfire_ask": "Would you like to rest for a while?",
	"campfire_rest": "Fully recovered.",

	"dock_unavailable:narration": "Nothing is tied up at the old dock.",
	"dock_unavailable": "It doesn't look usable yet.",
	"dock_ask:narration": "A small boat waits at the dock.",
	"dock_ask": "Are you sure you want to leave?",
	"dock_confirm_yes:narration": "(boards the boat)",

	"ruins_unavailable:narration": "A stone structure, half-buried in the sand, comes into view.",
	"ruins_unavailable": "It doesn't look like the entrance has been found yet.",
	"ruins_blocked_mummies:narration": "Before the ruins' sealed door. A chill runs down your spine.",
	"ruins_blocked_mummies": "The mummies wandering this land should be dealt with first.",
	"ruins_blocked_key:narration": "A worn keyhole is visible on the massive stone door.",
	"ruins_blocked_key": "A key is needed to open the door.",
	"ruins_ask:narration": "As the key slides in, the massive door slowly opens.",
	"ruins_ask": "Do you want to enter the ruins?",
	"ruins_confirm_yes:narration": "(steps into the ruins)",

	"locked_door": "It can't be entered right now.",

	"not_ready:narration": "It doesn't seem ready yet.",

	"filter_room_not_ready:narration": "It still looks dangerous inside. The Gatekeeper should be dealt with first.",
}

const TABLES: Dictionary = {
	"en": EN,
}


# 현재 언어의 번역을 반환. 번역이 없거나 한국어면 빈 문자열 — 호출부가 원문으로 폴백한다
static func get_line(key: String) -> String:
	if key == "":
		return ""
	var table: Dictionary = TABLES.get(LocaleManager.current_locale(), {})
	return table.get(key, "")
