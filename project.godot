; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="project-jrpg"
run/main_scene="res://ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://systems/game_state.gd"
MusicManager="*res://systems/music_manager.tscn"
SFXPlayer="*res://systems/sfx_player.gd"
SceneManager="*uid://knvov1w0ek8m"
FadeOverlay="*res://systems/fade_overlay.tscn"
SceneTint="*res://systems/scene_tint.tscn"
SaveManager="*res://systems/save_manager.gd"
PauseMenu="*res://ui/pause_menu.tscn"
GameOverScreen="*res://ui/game_over_screen.tscn"
LevelUpPopup="*res://ui/level_up_popup.tscn"
ShopMenu="*res://ui/shop_menu.tscn"
WeaponShopMenu="*res://ui/weapon_shop_menu.tscn"
SaveSlotMenu="*res://ui/save_slot_menu.tscn"
BountyBoardMenu="*res://ui/bounty_board_menu.tscn"
EndingRecordMenu="*res://ui/ending_record_menu.tscn"
HUD="*res://ui/hud.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/default_theme.tres"

