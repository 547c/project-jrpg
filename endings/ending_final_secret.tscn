[node name="BodyLabel" type="Label" parent="UI/VBox"]
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 3
text = "당신과 카밀은 그날의 이야기를 다시 꺼내지 않았다. 유적의 문은 닫혔고, 벽에 새겨진 글자는 모래에 덮였다.
사람들은 여전히 마른 땅을 원망했지만, 누구를 원망해야 하는지는 끝내 알지 못했다.
나딤은 아무것도 묻지 않았다. 다만 가끔, 먼 바다 쪽을 오래 바라볼 뿐이었다.
지켜진 비밀은 아무도 다치게 하지 않았다 — 그리고 아무것도 되돌리지 못했다."

[node name="ContinueButton" type="Button" parent="UI/VBox"]
