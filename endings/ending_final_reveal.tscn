text = "진실을 밝히다"

[node name="BodyLabel" type="Label" parent="UI/VBox"]
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 3
text = "카밀은 더 이상 아무것도 숨기지 않았다. 감시자들이 오래전 저지른 실수가, 마침내 사람들의 입에 오르내리기 시작했다.
누군가는 그들을 원망했고, 누군가는 이제라도 알게 된 것을 다행이라 했다. 나딤은 언니의 이름을 다시 입에 담았다.
말라붙은 땅이 하루아침에 되살아나지는 않았다. 다만 이제, 그것을 되돌리려는 사람이 한 명이 아니었다.
당신이 건넨 한마디에서, 아주 느리게 — 무언가가 다시 흐르기 시작했다."

[node name="ContinueButton" type="Button" parent="UI/VBox"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "게임 종료"
